    "test:watch": "vitest",
    "install-to-vault": "node scripts/install-to-vault.mjs"
  },
  "dependencies": {
    "@moss-dev/moss": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.3",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
